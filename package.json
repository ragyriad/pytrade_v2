{
  "name": "pytrade",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "turbo run build",
    "build:api": "pnpm --filter @repo/api build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --project node",
    "test:components": "vitest run --config vitest.config.ts --project components",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts --pass-with-no-tests",
    "test:ci": "pnpm test && pnpm test:integration && pnpm test:e2e",
    "lint:theme": "node apps/web/scripts/checkThemeColors.mjs",
    "clean:web": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force apps/web/.next -ErrorAction SilentlyContinue\"",
    "typecheck:api": "pnpm --filter @repo/api typecheck",
    "market-data:build": "pnpm --filter @repo/market-data-sync build",
    "market-data:sync": "pnpm --filter @repo/market-data-sync sync",
    "market-data:sync:all": "pnpm --filter @repo/market-data-sync sync:all",
    "market-data:test": "pnpm --filter @repo/market-data-sync test",
    "market-data:test:unit": "pnpm --filter @repo/market-data-sync test:unit",
    "snaptrade:sync": "pnpm --filter @repo/snaptrade-sync sync",
    "db:generate": "turbo run db:generate --filter=@repo/db",
    "db:migrate": "turbo run db:migrate --filter=@repo/db",
    "auth:link-admin": "dotenv -e .env -- tsx packages/db/src/scripts/link_existing_admin.ts",
    "data:normalizer:test": "pnpm --filter @repo/data-normalizer test",
    "data:deduplicator:test": "pnpm --filter @repo/data-deduplicator test",
    "data:normalize-existing": "tsx scripts/data/normalize_existing.ts",
    "data:deduplicate-existing": "tsx scripts/data/deduplicate_existing.ts",
    "data:reset-imports": "dotenv -e .env -- tsx scripts/data/reset_imported_data.ts",
    "sqlite:import": "pnpm --filter @repo/questrade-legacy-import run import",
    "statements:extract": "pnpm --filter @repo/questrade-statement-import extract",
    "statements:import": "pnpm --filter @repo/questrade-statement-import run import"
  },
  "dependencies": {
    "@repo/data-deduplicator": "workspace:*",
    "@repo/data-normalizer": "workspace:*",
    "@repo/db": "workspace:*",
    "dotenv": "^17.4.2",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "dotenv-cli": "7.4.4",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.21.0",
    "turbo": "2.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
