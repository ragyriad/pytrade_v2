{
  "name": "pytrade",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "turbo run build",
    "build:api": "pnpm --filter @repo/api build",
    "build:web": "pnpm --filter web build",
    "clean:web": "powershell -NoProfile -Command \"Remove-Item -Recurse -Force apps/web/.next -ErrorAction SilentlyContinue\"",
    "typecheck:api": "pnpm --filter @repo/api typecheck",
    "sync": "pnpm --filter @repo/snaptrade-sync sync",
    "transaction_tofile": "pnpm --filter @repo/snaptrade-sync transaction_tofile",
    "position_tofile": "pnpm --filter @repo/snaptrade-sync position_tofile",
    "db:generate": "turbo run db:generate --filter=@repo/db",
    "db:migrate": "turbo run db:migrate --filter=@repo/db",
    "transactions:dedupe:dry-run": "pnpm --filter @repo/db transactions:dedupe:dry-run",
    "transactions:dedupe:apply": "pnpm --filter @repo/db transactions:dedupe:apply",
    "securities:fix-options:dry-run": "pnpm --filter @repo/db securities:fix-options:dry-run",
    "securities:fix-options:apply": "pnpm --filter @repo/db securities:fix-options:apply",
    "securities:merge-duplicates:dry-run": "pnpm --filter @repo/db securities:merge-duplicates:dry-run",
    "securities:merge-duplicates:apply": "pnpm --filter @repo/db securities:merge-duplicates:apply"
  },
  "devDependencies": {
    "dotenv-cli": "7.4.4",
    "tsx": "^4.21.0",
    "turbo": "2.9.6",
    "typescript": "^5.9.3"
  }
}
