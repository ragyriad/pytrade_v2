{
  "name": "pytrade",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run --config vitest.config.ts",
    "market-data:sync": "pnpm --filter @repo/market-data-sync sync",
    "market-data:sync:all": "pnpm --filter @repo/market-data-sync sync:all",
    "snaptrade:sync": "pnpm turbo run build --filter=@repo/snaptrade-sync... && pnpm --filter @repo/snaptrade-sync sync",
    "snaptrade:sync:upsert-all": "pnpm turbo run build --filter=@repo/snaptrade-sync... && pnpm --filter @repo/snaptrade-sync sync -- --upsert-all",
    "db:generate": "pnpm --filter @repo/db run db:generate",
    "db:migrate": "pnpm --filter @repo/db run db:migrate",
    "auth:link-admin": "dotenv -e .env -- tsx packages/db/src/scripts/link_existing_admin.ts",
    "demo:seed": "tsx packages/db/src/demo/cli.ts seed",
    "demo:reset": "tsx packages/db/src/demo/cli.ts reset",
    "data:normalize-existing": "tsx scripts/data/normalize_existing.ts",
    "data:deduplicate-existing": "tsx scripts/data/deduplicate_existing.ts",
    "sqlite:import": "pnpm --filter @repo/questrade-legacy-import run import",
    "statements:extract": "pnpm --filter @repo/questrade-statement-import extract",
    "statements:import": "pnpm --filter @repo/questrade-statement-import run import",
    "test:integration": "tsx test/integration/run-integration.ts"
  },
  "dependencies": {
    "@repo/data-deduplicator": "workspace:*",
    "@repo/data-normalizer": "workspace:*",
    "@repo/db": "workspace:*",
    "dotenv": "^17.4.2",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "dotenv-cli": "7.4.4",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.21.0",
    "turbo": "2.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
