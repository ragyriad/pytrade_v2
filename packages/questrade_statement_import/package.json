{
  "name": "@repo/questrade-statement-import",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. --config ../../vitest.config.ts packages/questrade_statement_import/test/unit",
    "extract": "dotenv -e ../../.env -- tsx src/cli.ts",
    "import": "dotenv -e ../../.env -- tsx src/db_cli.ts"
  },
  "dependencies": {
    "@repo/data-deduplicator": "workspace:*",
    "@repo/data-normalizer": "workspace:*",
    "@repo/db": "workspace:*",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^5.4.296"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "dotenv-cli": "7.4.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
