{
  "name": "@repo/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "db:generate": "dotenv -e ../../../.env -- drizzle-kit generate",
    "db:generate:debug": "dotenv -e ../../../.env  NODE_OPTIONS='--stack-trace-limit=100' drizzle-kit generate 2>&1",
    "db:update": "dotenv -e ../../../.env -- drizzle-kit up",
    "db:migrate": "dotenv -e ../../../.env -- drizzle-kit migrate",
    "db:push": "dotenv -e ../../../.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../../../.env -- drizzle-kit studio",
    "db:pull": "dotenv -e ../../../.env -- drizzle-kit pull",
    "transactions:dedupe:dry-run": "tsx src/scripts/dedupe_transactions.ts",
    "transactions:dedupe:apply": "tsx src/scripts/dedupe_transactions.ts --apply",
    "securities:fix-options:dry-run": "tsx src/scripts/fix_option_security_symbols.ts",
    "securities:fix-options:apply": "tsx src/scripts/fix_option_security_symbols.ts --apply",
    "securities:merge-duplicates:dry-run": "tsx src/scripts/merge_duplicate_securities.ts",
    "securities:merge-duplicates:apply": "tsx src/scripts/merge_duplicate_securities.ts --apply",
    "securities:cleanup-cash-interest:dry-run": "tsx src/scripts/cleanup_cash_interest_securities.ts",
    "securities:cleanup-cash-interest:apply": "tsx src/scripts/cleanup_cash_interest_securities.ts --apply",
    "transactions:normalize:dry-run": "tsx src/scripts/normalize_transactions.ts",
    "transactions:normalize:apply": "tsx src/scripts/normalize_transactions.ts --apply",
    "tfsa-merge:review-report": "tsx src/scripts/generate_tfsa_merge_review_report.ts",
    "tfsa-merge:legacy-by-date:dry-run": "tsx src/scripts/merge_tfsa_legacy_by_date.ts",
    "tfsa-merge:legacy-by-date:apply": "tsx src/scripts/merge_tfsa_legacy_by_date.ts --apply"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "dotenv-cli": "7.4.4",
    "drizzle-kit": "1.0.0-beta.22",
    "drizzle-orm": "1.0.0-beta.22",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  }
}
