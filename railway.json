{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "preDeployCommand": "pnpm exec drizzle-kit migrate --config packages/db/drizzle.config.ts && pnpm demo:seed -- --profile=full",
    "startCommand": "node scripts/start-railway.mjs",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
